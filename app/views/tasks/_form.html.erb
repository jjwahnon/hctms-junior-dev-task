<%= form_with(model: task, local: true) do |f| %>
    <% if task.errors.any? %>
        <div class = "errors" >
            <h4><%= pluralize(task.errors.count, "error") %> prevented saving:</h4>
            <ul>
                <% task.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <div class="field">
        <%= f.label :title %><br>
        <%= f.text_field :title, required: true %>
    </div>

    <div class="field">
        <%= f.label :description %><br>
        <%= f.text_area :description, rows: 3 %>
    </div>

    <div class="field">
        <%= f.label :status %><br>
        <%= f.select :status, [['Pending', 'pending'], ['In Progress', 'in_progress'], ['Completed', 'completed'], ['Failed', 'failed']] %>
    </div>

    <div class="field">
        <%= f.label :due_date, "Due date/time" %><br>
        <%= f.datetime_field :due_date %>
    </div>

    <div class="field">
        <%= f.submit %>
        <%= link_to "Cancel", root_path, class: "button secondary" %>
    </div>
<% end %>

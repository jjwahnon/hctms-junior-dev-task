# Example Terraform variables
# Copy this file to terraform.tfvars and update with your actual values

aws_region     = "us-east-1"
environment    = "production"
app_name       = "apollo"
vpc_cidr       = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
private_subnets_cidr = ["10.0.1.0/24", "10.0.2.0/24"]
public_subnets_cidr  = ["10.0.101.0/24", "10.0.102.0/24"]

# Container configuration - COST OPTIMIZATION
container_port          = 3000
container_cpu           = 256              # 0.25 CPU
container_memory        = 512              # 512 MB
desired_count           = 1                # Number of tasks to run
min_count               = 0                # *** Set to 0 for zero cost when idle! ***
use_fargate_spot        = true             # Use Spot instances (70% cheaper)

# Scheduled auto-scaling (optional: shut down after hours)
enable_scheduled_scaling = false            # Set to true to enable
business_hours_start     = 8                # 8 AM UTC
business_hours_end       = 18               # 6 PM UTC
business_days            = [0, 1, 2, 3, 4] # Monday-Friday

# Docker image (leave empty to use ECR default, or set to your image)
# docker_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/apollo:latest"

# Database configuration - COST OPTIMIZATION
database_type           = "aurora-serverless"  # Use 'aurora-serverless' (pay-per-use) or 'postgres' (fixed cost)
database_name           = "apollo_db"
database_user           = "postgres"
# password will be prompted during terraform apply
# database_password     = "your-secure-password" 

# Aurora Serverless v2 (only used if database_type = "aurora-serverless")
aurora_min_capacity     = 0.5               # Scale down to 0.5 ACU = ~$1/month
aurora_max_capacity     = 2                 # Auto-scale up to 2 ACUs when needed

# Traditional RDS (only used if database_type = "postgres")
# database_instance_class      = "db.t3.micro"
# database_allocated_storage   = 20

# Rails configuration
# rails_master_key should be from config/master.key
# rails_master_key = "your-rails-master-key-here"

rails_log_level = "info"

# HTTPS configuration (optional)
enable_https       = false
# certificate_arn  = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"
# domain_name      = "apollo.example.com"

# Health check
health_check_path = "/up"
